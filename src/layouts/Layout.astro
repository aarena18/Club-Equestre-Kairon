---
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import { withBase } from "../lib/url";
import { photo } from "../lib/photos";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Centre équestre de Kairon Plage — poney club et club hippique entre mer et campagne à Saint-Pair-sur-Mer.",
} = Astro.props;

const og = await getImage({ src: photo("hero-vue-aerienne"), format: "jpg", width: 1200 });
const ogImage = new URL(og.src, Astro.site ?? Astro.url).href;

// La préview GitHub Pages est une maquette de démonstration : on demande
// aux moteurs de ne pas l'indexer (le vrai site sera sur son propre domaine).
const isPreview = import.meta.env.BASE_URL !== "/";
const formsDemo = isPreview || import.meta.env.DEV;
---

<!doctype html>
<html lang="fr" data-forms-demo={formsDemo ? "true" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#7cabb3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />

    <script>
      // Mode démonstration (préview GitHub Pages et dev local) : les formulaires
      // n'y ont pas de destination. Après la validation du navigateur, on
      // affiche la page de remerciement pour montrer le parcours complet.
      // En production (Netlify), l'attribut est absent et l'envoi est réel.
      if (document.documentElement.dataset.formsDemo === "true") {
        document.querySelectorAll<HTMLFormElement>("form[data-netlify]").forEach((form) => {
          form.addEventListener("submit", (e) => {
            e.preventDefault();
            location.href = form.action;
          });
        });
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -100px;
    z-index: 100;
    background: var(--color-pine);
    color: #fff;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-pill);
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
