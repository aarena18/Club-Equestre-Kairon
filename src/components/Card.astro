---
/**
 * LA carte du site : photo claire en haut (optionnelle), texte sur blanc.
 * Toute la carte est cliquable quand `href` est fourni (lien étiré sur le
 * titre), le libellé d'action reste toujours visible.
 */
import Photo from "./Photo.astro";

interface Props {
  title: string;
  text?: string | null;
  /** nom de photo locale ou URL Sanity */
  image?: string | null;
  imageAlt?: string;
  href?: string;
  cta?: string | null;
  /** petite pastille au-dessus du titre : tranche d'âge, date… */
  tag?: string | null;
  headingLevel?: 2 | 3;
  [key: string]: unknown;
}

const { title, text, image, imageAlt = "", href, cta, tag, headingLevel = 3, class: extraClass, ...rest } = Astro.props;
const H = `h${headingLevel}` as "h2" | "h3";
---

<article class:list={["card", extraClass, { "is-link": !!href }]} {...rest}>
  {
    image && (
      <Photo
        class="card-img"
        src={image}
        alt={imageAlt}
        sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 360px"
        widths={[360, 540, 720, 1000]}
      />
    )
  }
  <div class="card-body">
    {tag && <span class="card-tag">{tag}</span>}
    <H class="card-title">
      {href ? <a href={href}>{title}</a> : title}
    </H>
    {text && <p>{text}</p>}
    <slot />
    {href && <span class="card-cta" aria-hidden="true">{cta || "Découvrir"} →</span>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 2px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .card.is-link:hover,
  .card.is-link:focus-within {
    transform: translateY(-4px);
    border-color: var(--color-meadow);
    box-shadow: var(--shadow-soft);
  }

  .card :global(picture) {
    display: block;
  }

  .card-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-3);
  }

  .card-tag {
    align-self: flex-start;
    margin-bottom: 0.6rem;
    padding: 0.2rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-teal-mist);
    color: var(--color-teal-deep);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: var(--text-h3);
  }

  .card-title a {
    color: inherit;
    text-decoration: none;
  }

  /* lien étiré : toute la carte est cliquable */
  .card-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .card.is-link:has(.card-title a:focus-visible) {
    outline: 3px solid var(--color-pine);
    outline-offset: 3px;
  }

  p {
    margin: 0.6rem 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .card-cta {
    margin-top: auto;
    padding-top: var(--space-2);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-meadow-deep);
  }
</style>
