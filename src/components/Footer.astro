---
import Horse from "./Horse.astro";
import SocialIcons from "./SocialIcons.astro";
import { sanityClient } from "../lib/sanity";
import { withBase } from "../lib/url";
import { navLinks, ctaInscription, reseauxSociaux } from "../data/site";

const settings = await sanityClient.fetch(`*[_type == "siteSettings"][0]{telephone, email, adresse, facebook, instagram}`);
const instagram = settings?.instagram ?? reseauxSociaux.instagram;
const facebook = settings?.facebook ?? reseauxSociaux.facebook;
const hasSocials = Boolean(instagram || facebook);
---

<footer class="site-footer scallop-top">
  <div class="container footer-grid">
    <div class="brand">
      <img src={withBase("/images/logo-kairon.png")} alt="Centre équestre de Kairon Plage" width="120" height="120" />
      {
        hasSocials && (
          <>
            <p>Suivez-nous sur :</p>
            <SocialIcons instagram={instagram} facebook={facebook} size={30} />
          </>
        )
      }
    </div>

    <Horse name="peek" class="peek" />

    <nav class="col nav" aria-label="Plan du site">
      <h2>Navigation</h2>
      <ul>
        <li><a href={withBase("/")}>Accueil</a></li>
        {navLinks.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="col contact">
      <h2>Contact</h2>
      <ul>
        {settings?.telephone && <li><a href={`tel:${settings.telephone.replace(/\s/g, "")}`}>{settings.telephone}</a></li>}
        {settings?.email && <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>}
        <li>{settings?.adresse ?? "Saint-Pair-sur-Mer, Manche"}</li>
        <li><a href={withBase(ctaInscription.href)}>Réserver un cours d'essai</a></li>
      </ul>
    </div>

    <p class="legal">© {new Date().getFullYear()} Centre équestre de Kairon Plage<br />association Saint Pair Équitation</p>
  </div>
</footer>

<style>
  .site-footer {
    --scallop-color: var(--color-teal);
    background: var(--color-teal);
    color: #fff;
    margin-top: calc(var(--space-6) + var(--scallop-h));
    padding-top: var(--space-5);
  }

  /* 4 colonnes : marque | cheval qui dépasse | navigation | contact.
     Le cheval est un vrai élément de grille, collé au bas du footer :
     il ne peut jamais chevaucher les liens. */
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px auto auto;
    grid-template-rows: auto auto;
    column-gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .brand {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .brand img {
    width: 120px;
    height: auto;
  }

  .brand p {
    margin: var(--space-1) 0 0;
    font-size: 0.95rem;
  }

  .peek {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: end;
    width: 110px;
    height: auto;
    margin: var(--space-4) auto 0;
    color: var(--color-paper);
    display: block;
  }

  .nav {
    grid-area: 1 / 3;
  }

  .contact {
    grid-area: 1 / 4;
  }

  .col h2 {
    font-size: 1.05rem;
    text-transform: none;
    letter-spacing: 0.02em;
    color: #fff;
    margin-bottom: var(--space-2);
  }

  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.95rem;
  }

  .col a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .col a:hover {
    border-bottom-color: #fff;
  }

  .legal {
    grid-area: 2 / 1;
    align-self: end;
    margin: var(--space-4) 0 0;
    padding-bottom: var(--space-3);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
      row-gap: var(--space-4);
    }

    .brand {
      grid-area: 1 / 1 / 2 / 3;
      align-items: center;
      text-align: center;
    }

    .nav {
      grid-area: 2 / 1;
    }

    .contact {
      grid-area: 2 / 2;
    }

    .legal {
      grid-area: 3 / 1;
    }

    .peek {
      grid-area: 3 / 2;
      width: 80px;
      margin: 0 0 0 auto;
    }
  }
</style>
