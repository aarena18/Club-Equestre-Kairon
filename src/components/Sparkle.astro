---
interface Props {
  color?: string;
  size?: number;
}

const { color = "var(--color-sun)", size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  class="sparkle"
  aria-hidden="true"
  style={`color:${color};`}
>
  <path
    d="M12 0 C12.8 6.5 13.5 9 20 12 C13.5 15 12.8 17.5 12 24 C11.2 17.5 10.5 15 4 12 C10.5 9 11.2 6.5 12 0 Z"
    fill="currentColor"
  ></path>
</svg>

<style>
  .sparkle {
    display: block;
  }
</style>
