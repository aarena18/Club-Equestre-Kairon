---
// Bord festonné plein (pas de trous transparents entre les bosses) :
// un seul <path> SVG rempli de la couleur de la section, plutôt qu'un
// masque CSS à base de cercles tangents qui laisse des lentilles
// transparentes visibles entre chaque bosse.
interface Props {
  color: string;
  direction?: "down" | "up";
  height?: number;
}

const { color, direction = "down", height = 24 } = Astro.props;

const humps = 24;
const humpWidth = height * 2;
const totalWidth = humpWidth * humps;
const r = height;

let d = "M0,0";
for (let i = 1; i <= humps; i++) {
  d += ` A${r},${r} 0 0,0 ${humpWidth * i},0`;
}
d += ` L${totalWidth},0 Z`;
---

<svg
  class="scallop"
  viewBox={`0 0 ${totalWidth} ${height}`}
  preserveAspectRatio="none"
  style={`--scallop-h:${height}px; ${direction === "up" ? "transform:scaleY(-1);" : ""}`}
  aria-hidden="true"
>
  <path d={d} fill={color}></path>
</svg>

<style>
  .scallop {
    display: block;
    width: 100%;
    height: var(--scallop-h);
  }
</style>
