---
import { withBase } from "../lib/url";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const links = [
  { href: "/le-centre", label: "Le centre" },
  { href: "/activites", label: "Activités & cours" },
  { href: "/proprietaires-pension", label: "Pension" },
  { href: "/tarifs", label: "Tarifs" },
  { href: "/competition-vie-club", label: "Vie du club" },
  { href: "/infos-pratiques", label: "Infos pratiques" },
];
---

<div class:list={["header-shell", { overlay }]}>
  <header class="site-header">
    <a class="logo" href={withBase("/")}>Kairon Plage</a>

    <nav class="nav" id="nav-desktop">
      {links.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
    </nav>
    <a class="cta cta-desktop" href={withBase("/infos-pratiques#essai")}>Réserver un cours d'essai</a>

    <button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="nav-mobile">
      <span class="sr-only">Menu</span>
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </header>

  <nav class="nav-mobile" id="nav-mobile" hidden>
    {links.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
    <a class="cta" href={withBase("/infos-pratiques#essai")}>Réserver un cours d'essai</a>
  </nav>
</div>

<script>
  const toggle = document.getElementById("menu-toggle")!;
  const mobileNav = document.getElementById("nav-mobile")!;

  toggle.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    mobileNav.hidden = isOpen;
  });

  mobileNav.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      toggle.setAttribute("aria-expanded", "false");
      mobileNav.hidden = true;
    });
  });
</script>

<style>
  /* Barre "pilule" flottante, façon Freehold : inset de tous les
     bords, coins très arrondis, ombre portée — pas un bandeau plein
     largeur collé en haut. */
  .header-shell {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: var(--space-2) var(--space-2) 0;
    background: transparent;
    pointer-events: none;
  }

  /* Sur la home : la barre flotte PAR-DESSUS le hero (qui démarre tout
     en haut de la page) au lieu de réserver une bande blanche au-dessus. */
  .header-shell.overlay {
    position: fixed;
    left: 0;
    right: 0;
  }

  .site-header,
  .nav-mobile {
    pointer-events: auto;
  }

  .site-header {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.6rem 0.7rem 0.6rem 1.3rem;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    box-shadow: 0 10px 30px -12px rgba(35, 40, 30, 0.25);
  }

  .logo {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.05rem;
    color: var(--color-pine);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: var(--space-2);
  }

  .nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--color-pine);
  }

  .cta {
    display: inline-block;
    background: var(--color-pine);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: none;
  }

  .menu-toggle .bar {
    width: 16px;
    height: 2px;
    background: var(--color-ink);
    border-radius: 1px;
  }

  /* Panneau déroulant : carte flottante blanche sous la pilule, pas un
     bandeau plein largeur. */
  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 1180px;
    margin: 10px auto 0;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    box-shadow: 0 10px 30px -12px rgba(35, 40, 30, 0.25);
  }

  .nav-mobile a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .nav-mobile a.cta {
    align-self: flex-start;
    margin-top: 0.3rem;
    color: var(--color-paper);
  }

  @media (max-width: 980px) {
    .nav,
    .cta-desktop {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .nav-mobile:not([hidden]) {
      display: flex;
    }
  }
</style>
