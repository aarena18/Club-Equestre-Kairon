---
/**
 * "Le club en images" — cartes photo en éventail, celle du centre en avant.
 * Sans JS : simple défilement horizontal. Avec JS : carrousel + pastilles.
 */
interface Props {
  photos: { src: string; alt: string }[];
}

const { photos } = Astro.props;
const start = Math.floor(photos.length / 2);
---

<div class="gallery" data-gallery data-start={start}>
  <div class="stage">
    {
      photos.map((p, i) => (
        <figure class="slide" data-index={i}>
          <img src={p.src} alt={p.alt} loading="lazy" />
        </figure>
      ))
    }
  </div>
  <div class="dots" role="tablist" aria-label="Choisir une photo">
    {
      photos.map((p, i) => (
        <button type="button" role="tab" aria-label={`Photo ${i + 1} : ${p.alt}`} data-dot={i} />
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    let current = Number(gallery.dataset.start ?? 0);

    gallery.classList.add("is-enhanced");

    const render = () => {
      slides.forEach((slide, i) => {
        const offset = i - current;
        slide.style.setProperty("--offset", String(offset));
        slide.style.setProperty("--abs", String(Math.abs(offset)));
        slide.setAttribute("aria-hidden", String(offset !== 0));
        slide.classList.toggle("is-active", offset === 0);
      });
      dots.forEach((d, i) => d.setAttribute("aria-selected", String(i === current)));
    };

    slides.forEach((slide, i) => slide.addEventListener("click", () => ((current = i), render())));
    dots.forEach((dot, i) => dot.addEventListener("click", () => ((current = i), render())));

    // glisser du doigt sur mobile
    let startX = 0;
    gallery.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
    gallery.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) < 40) return;
      current = Math.min(slides.length - 1, Math.max(0, current + (dx < 0 ? 1 : -1)));
      render();
    });

    render();
  });
</script>

<style>
  .stage {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: var(--space-2);
  }

  .slide {
    margin: 0;
    flex: 0 0 min(70%, 380px);
    scroll-snap-align: center;
  }

  .slide img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 40px;
    border: 6px solid #fff;
    box-shadow: 0 20px 40px -20px rgba(29, 33, 27, 0.5);
  }

  .dots {
    display: none;
  }

  /* --- version améliorée (JS actif) : éventail --- */
  .is-enhanced .stage {
    position: relative;
    display: block;
    overflow: visible;
    height: clamp(380px, 52vw, 560px);
    padding: 0;
  }

  .is-enhanced .slide {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(220px, 30vw, 380px);
    cursor: pointer;
    transform: translateX(calc(-50% + var(--offset) * clamp(110px, 17vw, 230px)))
      rotate(calc(var(--offset) * 6deg)) scale(calc(1 - var(--abs) * 0.12));
    transform-origin: 50% 90%;
    z-index: calc(10 - var(--abs));
    opacity: calc(1 - var(--abs) * 0.12);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.3s ease;
  }

  .is-enhanced .slide:not(.is-active) img {
    filter: saturate(0.85);
  }

  .is-enhanced .dots {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: var(--space-3);
  }

  .dots button {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: var(--color-line);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .dots button[aria-selected="true"] {
    background: var(--color-ink);
    transform: scale(1.15);
  }
</style>
