---
/**
 * Bandeau photo en tête de page, bord inférieur festonné.
 * `size="full"` pour l'accueil, `"page"` (défaut) pour les rubriques.
 * Pas de sur-titre au-dessus du h1 : le titre porte seul la page.
 */
import Photo from "./Photo.astro";

interface Props {
  /** nom d'une photo locale ("pre-baie") ou URL Sanity */
  image: string;
  title: string;
  subtitle?: string;
  size?: "full" | "page";
  /** position CSS de la photo (object-position) */
  focus?: string;
}

const { image, title, subtitle, size = "page", focus = "center" } = Astro.props;
---

<section class:list={["page-hero", "scallop-bottom", size]}>
  <Photo
    class="bg"
    src={image}
    alt=""
    sizes="100vw"
    widths={[640, 1024, 1440, 1920, 2400]}
    loading="eager"
    fetchpriority="high"
    style={`object-position:${focus}`}
  />
  <div class="inner container">
    <h1>{title}</h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    {Astro.slots.has("default") && <div class="actions"><slot /></div>}
  </div>
</section>

<style>
  .page-hero {
    --scallop-color: var(--color-paper);
    position: relative;
    display: grid;
    place-items: center;
    min-height: 420px;
    padding: 140px 0 calc(var(--space-5) + var(--scallop-h));
    overflow: hidden;
    text-align: center;
    color: #fff;
    isolation: isolate;
  }

  .page-hero.full {
    min-height: min(100svh, 820px);
  }

  .page-hero :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* voile : assez dense derrière le texte pour rester lisible sur les zones claires de la photo */
  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 55% at 50% 55%, rgba(18, 32, 22, 0.55), rgba(18, 32, 22, 0.12) 80%),
      linear-gradient(180deg, rgba(18, 32, 22, 0.3), rgba(18, 32, 22, 0.08) 45%, rgba(18, 32, 22, 0.25));
  }

  .inner {
    max-width: 780px;
  }

  h1 {
    color: #fff;
    font-size: var(--text-h1);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  }

  .subtitle {
    margin: var(--space-2) auto 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }

  .actions {
    margin-top: var(--space-4);
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .page-hero {
      min-height: 360px;
      padding-top: 120px;
    }
  }
</style>
