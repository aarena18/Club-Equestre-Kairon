---
/** Une activité du CMS, rendue avec la carte unique du site. */
import Card from "./Card.astro";
import { urlFor } from "../lib/sanity";
import { photoParCategorie } from "../data/site";

interface Props {
  titre: string;
  trancheAge?: string | null;
  resume?: string | null;
  href?: string;
  categorie?: string;
  texteBouton?: string | null;
  /** photo Sanity de la fiche, sinon photo par défaut de la catégorie */
  photo?: any;
}

const { titre, trancheAge, resume, href, categorie, texteBouton, photo } = Astro.props;
const image = photo
  ? urlFor(photo).width(720).height(540).fit("crop").url()
  : categorie
    ? photoParCategorie[categorie]
    : undefined;
---

<Card
  class="activity-card"
  data-categorie={categorie}
  title={titre}
  text={resume}
  image={image}
  imageAlt={photo?.alt ?? ""}
  href={href}
  cta={texteBouton || "Découvrir"}
  tag={trancheAge}
/>
