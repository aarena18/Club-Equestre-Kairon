---
interface Props {
  titre: string;
  trancheAge?: string | null;
  resume?: string | null;
  href?: string;
  categorie?: string;
  texteBouton?: string | null;
}

const { titre, trancheAge, resume, href, categorie, texteBouton } = Astro.props;
const Tag = href ? "a" : "div";
---

<article class="activity-card" data-categorie={categorie}>
  <Tag class="activity-card-inner" href={href}>
    <h3>{titre}</h3>
    {trancheAge && <span class="tranche">{trancheAge}</span>}
    {resume && <p>{resume}</p>}
    {href && <span class="lien">{texteBouton || "Découvrir"} →</span>}
  </Tag>
</article>

<style>
  .activity-card {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .activity-card-inner {
    display: block;
    padding: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .activity-card h3 {
    font-size: 1.15rem;
    color: var(--color-pine);
  }

  .tranche {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-sky-deep);
  }

  .activity-card p {
    margin: 0.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .lien {
    display: inline-block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-coral);
  }
</style>
