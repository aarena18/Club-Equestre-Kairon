---
import Layout from "../../layouts/Layout.astro";
import BentoGrid from "../../components/ui/BentoGrid.astro";
import BentoCard from "../../components/ui/BentoCard.astro";
import PageHero from "../../components/PageHero.astro";
import SocialCards from "@/components/ui/card-fan-carousel";
import { sanityClient, urlFor } from "../../lib/sanity";
import { withBase } from "../../lib/url";
import { galerieStatique } from "../../data/site";

const articles = await sanityClient.fetch(
  `*[_type == "article"] | order(datePublication desc){titre, "slug": slug.current, categorie, datePublication, resume, photoCouverture}`,
);

const annees = [...new Set(articles.map((a: any) => new Date(a.datePublication).getFullYear()))].sort(
  (a, b) => (b as number) - (a as number),
);

const categoriesActu = [
  { value: "rentree", label: "Rentrée" },
  { value: "competition", label: "Compétition" },
  { value: "vie-du-club", label: "Vie du club" },
];

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });

// La galerie se remplit automatiquement des photos déjà présentes sur les
// activités et les actualités — pas besoin d'un type de contenu à part
// tant qu'il n'y a pas de vraies photos à y mettre.
const photosActivites = await sanityClient.fetch(
  `*[_type == "activite" && defined(photo)]{titre, photo}`,
);
const galerie = [
  ...photosActivites.map((a: any) => ({ alt: a.photo.alt || a.titre, image: a.photo })),
  ...articles.filter((a: any) => a.photoCouverture).map((a: any) => ({ alt: a.photoCouverture.alt || a.titre, image: a.photoCouverture })),
];
// Tant que le Studio n'a pas de photos, la galerie montre les photos du club
// fournies avec la maquette.
const photosGalerie =
  galerie.length > 0
    ? galerie.map((g: any) => ({ imgUrl: urlFor(g.image).width(800).height(1066).fit("crop").url(), alt: g.alt }))
    : galerieStatique.map((p) => ({ imgUrl: withBase(p.src), alt: p.alt }));
---

<Layout
  title="Compétition & vie du club — Kairon Plage"
  description="Challenge club d'hiver, sorties officielles, actualités et vie du centre équestre de Kairon Plage."
>
  <PageHero
    image="/images/carriere.jpg"
    eyebrow="Compétition & vie du club"
    title="Ce qui se passe à Kairon Plage"
    subtitle="Challenge d'hiver, sorties officielles, stages et moments partagés en famille."
  />

  <section class="section">
    <div class="container">
      <BentoGrid rows={2}>
        <BentoCard
          id="challenge"
          name="Challenge club d'hiver"
          description="Un challenge en CSO et Equifun, en 4 étapes, sur place et ouvert à tous les niveaux : une première approche de la compétition. Récompenses pour tous les participants, coupes aux trois premiers du classement général."
          icon="trophy"
          image="/images/carriere.jpg"
          area="1 / 1 / 3 / 2"
        />
        <BentoCard
          id="sorties"
          name="Résultats & sorties officielles"
          description="Dès le Galop 2 : des sorties tout au long de l'année, et au moins deux compétitions officielles organisées sur place chaque saison. Un bulletin d'engagement est à adresser au club au plus tard le dimanche précédant la compétition."
          icon="award"
          image="/images/adultes.jpg"
          area="1 / 2 / 2 / 4"
        />
        <BentoCard
          name="Saison 2026/2027"
          description="Calendrier et résultats à venir."
          icon="calendar"
          image="/images/plage-coucher-soleil.jpg"
          href="/competition-vie-club#actualites"
          cta="Suivre les actualités"
          area="2 / 2 / 3 / 4"
        />
      </BentoGrid>
    </div>
  </section>

  <section id="actualites" class="band band-mist scallop-top scallop-under">
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Actualités & événements</h2>
      </div>

      {
        articles.length > 0 ? (
          <>
            <div class="filters" role="group" aria-label="Filtrer les actualités par année">
              <button type="button" class="filter-btn" data-filter-type="annee" data-filter="tout" aria-pressed="true">
                Toutes les années
              </button>
              {annees.map((a) => (
                <button type="button" class="filter-btn" data-filter-type="annee" data-filter={String(a)} aria-pressed="false">
                  {a}
                </button>
              ))}
            </div>
            <div class="filters" role="group" aria-label="Filtrer par catégorie">
              <button type="button" class="filter-btn" data-filter-type="categorie" data-filter="tout" aria-pressed="true">
                Tout
              </button>
              {categoriesActu.map((c) => (
                <button type="button" class="filter-btn" data-filter-type="categorie" data-filter={c.value} aria-pressed="false">
                  {c.label}
                </button>
              ))}
            </div>

            <div class="grid actu-grid">
              {articles.map((a: any) => (
                <a
                  class="card actu-card"
                  href={withBase(`/competition-vie-club/actualites/${a.slug}`)}
                  data-annee={new Date(a.datePublication).getFullYear()}
                  data-categorie={a.categorie}
                >
                  {a.photoCouverture && (
                    <img src={urlFor(a.photoCouverture).width(600).height(400).fit("crop").url()} alt="" loading="lazy" />
                  )}
                  <span class="actu-date">{dateFormatter.format(new Date(a.datePublication))}</span>
                  <h3>{a.titre}</h3>
                  {a.resume && <p>{a.resume}</p>}
                </a>
              ))}
            </div>
          </>
        ) : (
          <p class="note center">Les premières actualités arrivent bientôt.</p>
        )
      }
    </div>
  </section>

  <section id="galerie" class="section galerie">
    <div class="container center">
      <h2 class="title-dots">Le club en images</h2>
    </div>
    <SocialCards client:visible cards={photosGalerie} label="Le club en images" />
  </section>
</Layout>

<script>
  const groups = new Map<string, string>([
    ["annee", "tout"],
    ["categorie", "tout"],
  ]);

  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".actu-card");

  function applyFilters() {
    cards.forEach((card) => {
      const matchAnnee = groups.get("annee") === "tout" || card.dataset.annee === groups.get("annee");
      const matchCategorie = groups.get("categorie") === "tout" || card.dataset.categorie === groups.get("categorie");
      card.hidden = !(matchAnnee && matchCategorie);
    });
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const type = button.dataset.filterType!;
      groups.set(type, button.dataset.filter!);

      document.querySelectorAll<HTMLButtonElement>(`[data-filter-type="${type}"]`).forEach((b) => {
        b.setAttribute("aria-pressed", String(b === button));
      });

      applyFilters();
    });
  });
</script>

<style>
  .filters {
    justify-content: center;
    margin-bottom: var(--space-2);
  }

  .actu-grid {
    margin-top: var(--space-3);
  }

  .actu-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .actu-card[hidden] {
    display: none;
  }

  .actu-card img {
    margin: calc(-1 * var(--space-3)) calc(-1 * var(--space-3)) var(--space-2);
    width: calc(100% + 2 * var(--space-3));
    max-width: none;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .actu-date {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-meadow-deep);
    margin-bottom: 0.4rem;
  }

  .galerie {
    overflow-x: clip;
    padding-bottom: 0;
  }
</style>
