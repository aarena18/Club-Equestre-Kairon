---
import { toHTML } from "@portabletext/to-html";
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import { sanityClient, urlFor } from "../../../lib/sanity";

export async function getStaticPaths() {
  const articles = await sanityClient.fetch(
    `*[_type == "article" && defined(slug.current)]{"slug": slug.current}`,
  );

  return articles.map((a: { slug: string }) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;

const article = await sanityClient.fetch(
  `*[_type == "article" && slug.current == $slug][0]{titre, categorie, datePublication, resume, contenu, photoCouverture}`,
  { slug },
);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });

const contenuHtml = article?.contenu
  ? toHTML(article.contenu, {
      components: {
        types: {
          image: ({ value }) => `<img src="${urlFor(value).width(800).url()}" alt="${value.alt ?? ""}" loading="lazy" />`,
        },
      },
    })
  : "";
---

<Layout title={`${article.titre} — Kairon Plage`} description={article.resume ?? undefined}>
  <Header />

  <main>
    <a class="back" href="/competition-vie-club#actualites">← Toutes les actualités</a>
    <p class="eyebrow">{dateFormatter.format(new Date(article.datePublication))}</p>
    <h1>{article.titre}</h1>

    <div class="body" set:html={contenuHtml} />
  </main>

  <footer class="site-footer">
    <p>Centre équestre de Kairon Plage — Saint-Pair-sur-Mer</p>
  </footer>
</Layout>

<style>
  main {
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-sky-deep);
    text-decoration: none;
  }

  .eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: var(--color-sky-deep);
    margin: 0;
  }

  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    color: var(--color-pine);
    margin: var(--space-2) 0 0;
  }

  .body {
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .body :global(p) {
    margin: 0 0 1em;
  }

  .body :global(img) {
    width: 100%;
    border-radius: var(--radius-card);
    margin: 1em 0;
  }

  .site-footer {
    margin-top: var(--space-5);
    padding: var(--space-3);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    border-top: 1px solid var(--color-line);
  }
</style>
