---
import { toHTML } from "@portabletext/to-html";
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import { sanityClient, urlFor } from "../../../lib/sanity";
import { withBase } from "../../../lib/url";

export async function getStaticPaths() {
  const articles = await sanityClient.fetch(
    `*[_type == "article" && defined(slug.current)]{"slug": slug.current}`,
  );

  return articles.map((a: { slug: string }) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;

const article = await sanityClient.fetch(
  `*[_type == "article" && slug.current == $slug][0]{titre, categorie, datePublication, resume, contenu, photoCouverture}`,
  { slug },
);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });

const contenuHtml = article?.contenu
  ? toHTML(article.contenu, {
      components: {
        types: {
          image: ({ value }) => `<img src="${urlFor(value).width(800).url()}" alt="${value.alt ?? ""}" loading="lazy" />`,
        },
      },
    })
  : "";
const heroImage = article.photoCouverture
  ? urlFor(article.photoCouverture).width(1800).height(900).fit("crop").url()
  : "plage-groupe";
---

<Layout title={`${article.titre} — Kairon Plage`} description={article.resume ?? undefined}>
  <PageHero image={heroImage} title={article.titre} subtitle={article.resume ?? undefined} />

  <section class="section">
    <div class="container-narrow">
      <a class="link-arrow back" href={withBase("/competition-vie-club#actualites")}>← <span>Toutes les actualités</span></a>
      <p class="date">Publié le {dateFormatter.format(new Date(article.datePublication))}</p>
      {contenuHtml && <div class="prose" set:html={contenuHtml} />}
    </div>
  </section>
</Layout>

<style>
  .back {
    margin-bottom: var(--space-1);
  }

  .date {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-meadow-deep);
  }
</style>
