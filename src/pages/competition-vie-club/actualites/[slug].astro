---
import { toHTML } from "@portabletext/to-html";
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import { sanityClient, urlFor } from "../../../lib/sanity";
import { withBase } from "../../../lib/url";

export async function getStaticPaths() {
  const articles = await sanityClient.fetch(
    `*[_type == "article" && defined(slug.current)]{"slug": slug.current}`,
  );

  return articles.map((a: { slug: string }) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;

const article = await sanityClient.fetch(
  `*[_type == "article" && slug.current == $slug][0]{titre, categorie, datePublication, resume, contenu, photoCouverture}`,
  { slug },
);

const dateFormatter = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });

const contenuHtml = article?.contenu
  ? toHTML(article.contenu, {
      components: {
        types: {
          image: ({ value }) => `<img src="${urlFor(value).width(800).url()}" alt="${value.alt ?? ""}" loading="lazy" />`,
        },
      },
    })
  : "";
const heroExternal = Boolean(article.photoCouverture);
const heroImage = article.photoCouverture
  ? urlFor(article.photoCouverture).width(1800).height(900).fit("crop").url()
  : "/images/plage-coucher-soleil.jpg";
---

<Layout title={`${article.titre} — Kairon Plage`} description={article.resume ?? undefined}>
  <PageHero
    image={heroImage}
    external={heroExternal}
    eyebrow={dateFormatter.format(new Date(article.datePublication))}
    title={article.titre}
    subtitle={article.resume ?? undefined}
  />

  <section class="section">
    <div class="container-narrow">
      <a class="back" href={withBase("/competition-vie-club#actualites")}>← Toutes les actualités</a>
      {contenuHtml ? <div class="prose" set:html={contenuHtml} /> : <p class="note">Article complet à venir.</p>}
    </div>
  </section>
</Layout>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-weight: 500;
    color: var(--color-meadow-deep);
    text-decoration: none;
  }
</style>
