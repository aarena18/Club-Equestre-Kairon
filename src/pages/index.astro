---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Horse from "../components/Horse.astro";
import Faq from "../components/Faq.astro";
import ContactBlock from "../components/ContactBlock.astro";
import SocialCards from "@/components/ui/card-fan-carousel";
import BentoGrid from "../components/ui/BentoGrid.astro";
import BentoCard from "../components/ui/BentoCard.astro";
import { sanityClient, urlFor } from "../lib/sanity";
import { withBase } from "../lib/url";
import { faq, galerieStatique, ctaInscription, photoParCategorie } from "../data/site";

// Les 5 activités mises en avant sur l'accueil, dans l'ordre du bento
// (placement = row-start / col-start / row-end / col-end).
const vedettes = [
  { categorie: "baby-cavaliers", area: "1 / 1 / 3 / 2", icon: "heart" },
  { categorie: "adultes", area: "1 / 2 / 2 / 3", icon: "users" },
  { categorie: "expert-competition", area: "1 / 3 / 2 / 4", icon: "trophy" },
  { categorie: "balades-randonnees", area: "2 / 2 / 3 / 3", icon: "leaf" },
  { categorie: "stages-vacances", area: "2 / 3 / 3 / 4", icon: "calendar" },
] as const;

const activites = await sanityClient.fetch(
  `*[_type == "activite" && categorie in $categories]{titre, "slug": slug.current, categorie, resume, photo}`,
  { categories: vedettes.map((v) => v.categorie) },
);

const disciplines = vedettes.flatMap((v) => {
  const a = activites.find((x: any) => x.categorie === v.categorie);
  if (!a) return [];
  return [
    {
      ...v,
      titre: a.titre,
      resume: a.resume,
      href: a.slug ? `/activites/${a.slug}` : "/activites",
      image: a.photo
        ? urlFor(a.photo).width(900).height(900).fit("crop").url()
        : photoParCategorie[v.categorie],
    },
  ];
});

const photos = galerieStatique.map((p) => ({ imgUrl: withBase(p.src), alt: p.alt }));
---

<Layout title="Kairon Plage — Poney club & club hippique à Saint-Pair-sur-Mer">
  <PageHero
    size="full"
    image="/images/hero-vue-aerienne.jpg"
    title="Devenir cavalier dès 2 ans"
    subtitle="Situé entre mer et campagne, le centre équestre de Kairon Plage vous propose une pédagogie ludique !"
  >
    <a class="btn btn-glass" href={withBase("/le-centre")}>Découvrir le club</a>
    <a class="btn btn-teal" href={withBase(ctaInscription.href)}>{ctaInscription.label}</a>
  </PageHero>

  <section class="section disciplines">
    <Horse name="headLeft" class="deco deco-left" />
    <Horse name="headRight" class="deco deco-right" />

    <div class="container center">
      <h2 class="title-dots">Nos disciplines</h2>
      <p class="lede">
        Du baby cavalier au cours Expert, en passant par l'Equifeel et les balades en bord de mer, le centre
        équestre de Kairon Plage propose de nombreuses activités, pour tous les âges et tous les niveaux !
      </p>

      <div class="discipline-bento">
        <BentoGrid rows={2}>
          {
            disciplines.map((d) => (
              <BentoCard
                name={d.titre}
                description={d.resume}
                icon={d.icon}
                image={d.image}
                href={d.href}
                cta="Découvrir"
                area={d.area}
              />
            ))
          }
        </BentoGrid>
      </div>

      <a class="btn" href={withBase("/activites")}>Voir toutes nos activités</a>
    </div>
  </section>

  <section class="band scallop-top scallop-under">
    <div class="container-narrow center">
      <h2 class="title-dots on-color">Notre centre équestre</h2>
      <p>
        Depuis plus de 50 ans, nous développons une pédagogie « poney », dans l'esprit du mouvement poney né en
        France dans les années 1970.
      </p>
      <p>
        Dès leurs 2 ans, les cavaliers se familiarisent avec le poney ; la pédagogie ludique les accompagne ensuite
        chacun vers l'instruction et les passages de galops, jusqu'à la compétition pour qui le souhaite !
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Faq items={faq} />
    </div>
  </section>

  <ContactBlock />

  <section class="section labels">
    <div class="container labels-row">
      <h2 class="title-dots">Nos labels</h2>
      <img
        src={withBase("/images/labels.png")}
        alt="Labels : Bien-être animal FFE, École Française d'Équitation, Crinières solidaires, Ville de Saint-Pair-sur-Mer"
        loading="lazy"
        width="1452"
        height="296"
      />
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container center">
      <h2 class="title-dots">Le club en images</h2>
    </div>
    <SocialCards client:visible cards={photos} label="Le club en images" />
  </section>
</Layout>

<style>
  /* --- Nos disciplines --- */
  .disciplines {
    overflow-x: clip;
  }

  .deco {
    position: absolute;
    top: 80px;
    height: auto;
    pointer-events: none;
  }

  .deco-left {
    left: 0;
    width: clamp(70px, 11vw, 160px);
    color: var(--color-teal);
  }

  .deco-right {
    right: 0;
    top: 110px;
    width: clamp(70px, 11vw, 165px);
    color: var(--color-meadow);
  }

  .discipline-bento {
    margin: var(--space-4) 0;
    text-align: left;
  }

  /* --- bandeau orange --- */
  .band p {
    font-size: 1.08rem;
    margin: 0 0 0.8rem;
  }

  /* --- labels --- */
  .labels-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .labels-row h2 {
    margin-bottom: 0;
    justify-self: start;
  }

  .labels-row img {
    width: 100%;
    max-width: 640px;
    height: auto;
    justify-self: end;
  }

  .gallery-section {
    overflow-x: clip;
    padding-bottom: 0;
  }

  @media (max-width: 700px) {
    .deco {
      top: 20px;
      opacity: 0.35;
    }

    .labels-row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .labels-row h2,
    .labels-row img {
      justify-self: center;
    }
  }
</style>
