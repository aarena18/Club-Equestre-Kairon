---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Horse from "../components/Horse.astro";
import Faq from "../components/Faq.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Gallery from "../components/Gallery.astro";
import { withBase } from "../lib/url";
import { faq, galerieStatique, ctaInscription } from "../data/site";

const disciplines = [
  { label: "Enfants", image: "/images/enfants.jpg", href: "/activites#baby-cavaliers", alt: "Un baby cavalier casqué marche dans la carrière" },
  { label: "Adultes", image: "/images/adultes.jpg", href: "/activites#adultes", alt: "Une cavalière franchit un obstacle de CSO" },
  { label: "Vacances", image: "/images/vacances.jpg", href: "/activites#stages-vacances", alt: "Groupe d'enfants en stage avec deux poneys blancs" },
];

const photos = galerieStatique.map((p) => ({ ...p, src: withBase(p.src) }));
---

<Layout title="Kairon Plage — Poney club & club hippique à Saint-Pair-sur-Mer">
  <PageHero
    size="full"
    image="/images/hero-vue-aerienne.jpg"
    title="Devenir cavalier dès 2 ans"
    subtitle="Situé entre mer et campagne, le centre équestre de Kairon Plage vous propose une pédagogie ludique !"
  >
    <a class="btn btn-glass" href={withBase("/le-centre")}>Découvrir le club</a>
    <a class="btn btn-teal" href={withBase(ctaInscription.href)}>{ctaInscription.label}</a>
  </PageHero>

  <section class="section disciplines">
    <Horse name="headLeft" class="deco deco-left" />
    <Horse name="headRight" class="deco deco-right" />

    <div class="container center">
      <h2 class="title-dots">Nos disciplines</h2>
      <p class="lede">
        Du baby cavalier au cours Expert, en passant par l'Equifeel et les balades en bord de mer, le centre
        équestre de Kairon Plage propose de nombreuses activités, pour tous les âges et tous les niveaux !
      </p>

      <div class="discipline-grid">
        {
          disciplines.map((d) => (
            <a class="discipline" href={withBase(d.href)}>
              <img src={withBase(d.image)} alt={d.alt} loading="lazy" />
              <span class="label-dots">{d.label}</span>
            </a>
          ))
        }
      </div>

      <a class="btn" href={withBase("/activites")}>Voir toutes nos activités</a>
    </div>
  </section>

  <section class="band scallop-top scallop-under">
    <div class="container-narrow center">
      <h2 class="title-dots on-color">Notre centre équestre</h2>
      <p>
        Depuis plus de 50 ans, nous développons une pédagogie « poney », dans l'esprit du mouvement poney né en
        France dans les années 1970.
      </p>
      <p>
        Dès leurs 2 ans, les cavaliers se familiarisent avec le poney ; la pédagogie ludique les accompagne ensuite
        chacun vers l'instruction et les passages de galops, jusqu'à la compétition pour qui le souhaite !
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Faq items={faq} />
    </div>
  </section>

  <ContactBlock />

  <section class="section labels">
    <div class="container labels-row">
      <h2 class="title-dots">Nos labels</h2>
      <img
        src={withBase("/images/labels.png")}
        alt="Labels : Bien-être animal FFE, École Française d'Équitation, Crinières solidaires, Ville de Saint-Pair-sur-Mer"
        loading="lazy"
        width="1452"
        height="296"
      />
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container center">
      <h2 class="title-dots">Le club en images</h2>
    </div>
    <Gallery photos={photos} />
  </section>
</Layout>

<style>
  /* --- Nos disciplines --- */
  .disciplines {
    overflow-x: clip;
  }

  .deco {
    position: absolute;
    top: 80px;
    height: auto;
    pointer-events: none;
  }

  .deco-left {
    left: 0;
    width: clamp(70px, 11vw, 160px);
    color: var(--color-teal);
  }

  .deco-right {
    right: 0;
    top: 110px;
    width: clamp(70px, 11vw, 165px);
    color: var(--color-meadow);
  }

  .discipline-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 220px));
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 5rem);
    margin: var(--space-4) 0 var(--space-4);
  }

  .discipline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-ink);
    text-decoration: none;
  }

  .discipline img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-photo);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .discipline:hover img {
    transform: translateY(-6px) rotate(-1.5deg);
    box-shadow: var(--shadow-soft);
  }

  /* --- bandeau orange --- */
  .band p {
    font-size: 1.08rem;
    margin: 0 0 0.8rem;
  }

  /* --- labels --- */
  .labels-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .labels-row h2 {
    margin-bottom: 0;
    justify-self: start;
  }

  .labels-row img {
    width: 100%;
    max-width: 640px;
    height: auto;
    justify-self: end;
  }

  .gallery-section {
    overflow-x: clip;
    padding-bottom: 0;
  }

  @media (max-width: 700px) {
    .discipline-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.8rem;
    }

    .discipline .label-dots {
      font-size: 0.82rem;
    }

    .deco {
      top: 20px;
      opacity: 0.35;
    }

    .labels-row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .labels-row h2,
    .labels-row img {
      justify-self: center;
    }
  }
</style>
