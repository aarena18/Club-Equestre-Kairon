---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import DotList from "../../components/DotList.astro";
import Horse from "../../components/Horse.astro";
import SocialIcons from "../../components/SocialIcons.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";
import { faq, reseauxSociaux } from "../../data/site";

const siteSettings = await sanityClient.fetch(
  `*[_type == "siteSettings"][0]{telephone, email, adresse, horaires, facebook, instagram}`,
);

const instagram = siteSettings?.instagram ?? reseauxSociaux.instagram;
const facebook = siteSettings?.facebook ?? reseauxSociaux.facebook;

const deroule = [
  { title: "Vous envoyez la demande", text: "Deux minutes : l'âge et le niveau du cavalier suffisent pour commencer." },
  { title: "Le centre vous recontacte", text: "Pour convenir ensemble d'un créneau qui vous arrange." },
  { title: "Premier cours", text: "Un cours adapté à l'âge et au niveau du cavalier, sans engagement." },
];
---

<Layout
  title="Infos pratiques & contact — Kairon Plage"
  description="Demande de cours d'essai, accès, horaires et contact du centre équestre de Kairon Plage, Saint-Pair-sur-Mer."
>
  <PageHero
    image="plage-groupe"
    title="S'inscrire, nous trouver, nous contacter"
    subtitle="L'inscription commence par un cours d'essai : faites votre demande juste en dessous."
  />

  <section id="essai" class="band scallop-top scallop-under essai">
    <Horse name="gallopTeal" class="deco" />
    <div class="container essai-grid">
      <div class="panel">
        <h2 class="title-dots">Demander un cours d'essai</h2>

        <form class="form" name="demande-essai" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action={withBase("/merci")}>
          <input type="hidden" name="form-name" value="demande-essai" />
          <div class="hidden-field" aria-hidden="true">
            <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </div>

          <p class="form-hint">Les champs marqués <span class="required">*</span> sont obligatoires.</p>

          <div class="field">
            <label for="nom">Nom et prénom <span class="required" aria-hidden="true">*</span></label>
            <input id="nom" name="nom" type="text" autocomplete="name" required />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email <span class="required" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="telephone">Téléphone</label>
              <input id="telephone" name="telephone" type="tel" autocomplete="tel" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="age">Âge du cavalier (en années)</label>
              <input id="age" name="age" type="number" inputmode="numeric" min="2" max="99" placeholder="Ex. 5" />
            </div>
            <div class="field">
              <label for="niveau">Niveau</label>
              <select id="niveau" name="niveau">
                <option value="debutant">Débutant / jamais monté</option>
                <option value="quelques-cours">Quelques cours suivis ailleurs</option>
                <option value="confirme">Confirmé, cherche un club</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="disponibilites">Disponibilités</label>
            <input id="disponibilites" name="disponibilites" type="text" placeholder="Ex. mercredi après-midi" />
          </div>

          <div class="field">
            <label for="message">Message (facultatif)</label>
            <textarea id="message" name="message" rows="3"></textarea>
          </div>

          <button type="submit" class="btn btn-teal">Envoyer ma demande d'essai</button>
          <p class="privacy">Vos coordonnées servent uniquement à vous recontacter au sujet de cette demande.</p>
        </form>
      </div>

      <aside class="deroule" aria-label="Comment se passe la suite">
        <h2 class="title-dots on-color">Comment ça se passe</h2>
        <DotList items={deroule} numbered />
      </aside>
    </div>
  </section>

  <section id="coordonnees" class="section">
    <div class="container coords">
      <div>
        <h2 class="title-dots">Nous trouver</h2>
        <p class="lede">
          Centre équestre de Kairon Plage<br />
          {siteSettings?.adresse ?? "Saint-Pair-sur-Mer, Manche (Normandie)"}
        </p>
      </div>

      {
        siteSettings?.horaires?.length > 0 && (
          <div>
            <h2 class="title-dots">Horaires</h2>
            <ul class="plain">
              {siteSettings.horaires.map((h: string) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        (siteSettings?.telephone || siteSettings?.email) && (
          <div>
            <h2 class="title-dots">Nous joindre</h2>
            <ul class="plain">
              {siteSettings.telephone && <li>{siteSettings.telephone}</li>}
              {siteSettings.email && <li>{siteSettings.email}</li>}
            </ul>
          </div>
        )
      }

      {
        (instagram || facebook) && (
          <div>
            <h2 class="title-dots">Suivre le club</h2>
            <SocialIcons instagram={instagram} facebook={facebook} size={34} />
          </div>
        )
      }
    </div>
  </section>

  <section id="faq" class="section">
    <div class="container">
      <Faq items={faq} />
    </div>
  </section>
</Layout>

<style>
  .essai {
    overflow-x: clip;
  }

  .essai-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: var(--space-5);
    align-items: start;
  }

  .deroule {
    --dots: var(--color-pine);
  }

  .deroule :global(.dot-list p) {
    color: var(--color-ink);
    font-size: var(--text-base);
  }

  .deroule :global(.num) {
    background: var(--color-pine);
  }

  .deco {
    position: absolute;
    right: -2%;
    bottom: -10px;
    width: clamp(160px, 26vw, 380px);
    height: auto;
    color: var(--color-paper);
    opacity: 0.35;
    z-index: 1;
  }

  .coords {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-4);
  }

  .coords .title-dots {
    font-size: var(--text-h3);
    margin-bottom: var(--space-2);
  }

  .coords .lede {
    font-size: var(--text-base);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-ink-soft);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  @media (max-width: 900px) {
    .essai-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .deco {
      display: none;
    }
  }
</style>
