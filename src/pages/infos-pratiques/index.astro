---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import Horse from "../../components/Horse.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";
import { faq } from "../../data/site";

const siteSettings = await sanityClient.fetch(
  `*[_type == "siteSettings"][0]{telephone, email, adresse, horaires, facebook, instagram}`,
);
---

<Layout
  title="Infos pratiques & contact — Kairon Plage"
  description="Horaires, accès et formulaire de demande de cours d'essai au centre équestre de Kairon Plage, Saint-Pair-sur-Mer."
>
  <PageHero
    image="/images/plage-groupe.jpg"
    eyebrow="Infos pratiques"
    title="Nous trouver, nous contacter"
    subtitle="Entre mer et campagne, à Saint-Pair-sur-Mer (Manche)."
  />

  <section class="section">
    <div class="container info-grid">
      <div id="trouver" class="info-card">
        <h2 class="title-dots">Nous trouver</h2>
        <p>
          Centre équestre de Kairon Plage<br />Saint-Pair-sur-Mer, Manche (Normandie)
          {siteSettings?.adresse && <><br />{siteSettings.adresse}</>}
        </p>
        {!siteSettings?.adresse && <p class="note">Adresse précise à venir.</p>}
      </div>

      <div id="horaires" class="info-card">
        <h2 class="title-dots">Horaires</h2>
        {
          siteSettings?.horaires && siteSettings.horaires.length > 0 ? (
            <ul>
              {siteSettings.horaires.map((h: string) => <li>{h}</li>)}
            </ul>
          ) : (
            <p class="note">Horaires à venir — contactez le centre directement en attendant.</p>
          )
        }
      </div>

      <div class="info-card">
        <h2 class="title-dots">Nous joindre</h2>
        {
          siteSettings?.telephone || siteSettings?.email ? (
            <ul>
              {siteSettings.telephone && <li><a href={`tel:${siteSettings.telephone.replace(/\s/g, "")}`}>{siteSettings.telephone}</a></li>}
              {siteSettings.email && <li><a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a></li>}
            </ul>
          ) : (
            <p class="note">Coordonnées à venir — utilisez le formulaire ci-dessous.</p>
          )
        }
      </div>
    </div>
  </section>

  <section id="faq" class="section faq-section">
    <div class="container">
      <Faq items={faq} />
    </div>
  </section>

  <section id="essai" class="band scallop-top scallop-under essai">
    <Horse name="gallopTeal" class="deco" />
    <div class="container-narrow">
      <div class="form-card">
        <h2 class="title-dots">Réserver un cours d'essai</h2>
        <p class="lede">Remplissez ce formulaire, le centre vous recontacte pour convenir d'un créneau.</p>

        <form class="form" name="demande-essai" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" action={withBase("/merci")}>
          <input type="hidden" name="form-name" value="demande-essai" />
          <p class="hidden-field">
            <label>Ne pas remplir : <input name="bot-field" /></label>
          </p>

          <div class="field">
            <label for="nom">Nom et prénom</label>
            <input id="nom" name="nom" type="text" autocomplete="name" required />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="telephone">Téléphone</label>
              <input id="telephone" name="telephone" type="tel" autocomplete="tel" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="age">Âge du cavalier</label>
              <input id="age" name="age" type="text" placeholder="Ex. 5 ans" />
            </div>
            <div class="field">
              <label for="niveau">Niveau</label>
              <select id="niveau" name="niveau">
                <option value="debutant">Débutant / jamais monté</option>
                <option value="quelques-cours">Quelques cours suivis ailleurs</option>
                <option value="confirme">Confirmé, cherche un club</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="disponibilites">Disponibilités</label>
            <input id="disponibilites" name="disponibilites" type="text" placeholder="Ex. mercredi après-midi" />
          </div>

          <div class="field">
            <label for="message">Message (facultatif)</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>

          <button type="submit" class="btn">Envoyer ma demande</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--space-3);
  }

  .info-card {
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background: var(--color-teal-mist);
    scroll-margin-top: 110px;
  }

  .info-card h2 {
    font-size: 1.15rem;
    margin-bottom: var(--space-2);
  }

  .info-card p,
  .info-card ul {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .info-card ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .faq-section {
    padding-top: 0;
  }

  .essai {
    overflow-x: clip;
  }

  .form-card {
    position: relative;
    z-index: 2;
    padding: var(--space-4);
    border-radius: 36px;
    background: #fff;
    color: var(--color-ink);
    box-shadow: 0 30px 60px -30px rgba(29, 33, 27, 0.45);
  }

  .form-card .lede {
    color: var(--color-ink-soft);
  }

  .deco {
    position: absolute;
    right: -2%;
    bottom: -10px;
    width: clamp(160px, 26vw, 380px);
    height: auto;
    color: var(--color-paper);
    opacity: 0.35;
    z-index: 1;
  }

  @media (max-width: 700px) {
    .form-card {
      padding: var(--space-3) var(--space-2);
    }
  }
</style>
