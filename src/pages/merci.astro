---
import ThankYou from "../components/ThankYou.astro";
import { withBase } from "../lib/url";
---

<ThankYou
  image="vacances"
  title="Merci, à très vite au club !"
  subtitle="Votre demande de cours d'essai est bien partie. Le centre équestre de Kairon Plage vous recontacte pour convenir d'un créneau."
  steps={[
    { title: "Le centre vous recontacte", text: "Par téléphone ou par email, selon les coordonnées que vous avez laissées." },
    {
      title: "Vous choisissez un créneau",
      text: "Le premier cours est adapté à l'âge et au niveau du cavalier.",
      href: withBase("/activites"),
      cta: "Parcourir les activités en attendant",
    },
    {
      title: "Ensuite, l'inscription",
      text: "Si l'essai vous plaît : contrat d'inscription et choix du forfait.",
      href: withBase("/tarifs"),
      cta: "Voir les tarifs",
    },
  ]}
/>
