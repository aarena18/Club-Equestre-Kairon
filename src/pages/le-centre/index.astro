---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Photo from "../../components/Photo.astro";
import DotList from "../../components/DotList.astro";
import Horse from "../../components/Horse.astro";
import { sanityClient, urlFor } from "../../lib/sanity";
import { withBase } from "../../lib/url";

const equipe = await sanityClient.fetch(
  `*[_type == "membreEquipe"] | order(ordre asc){nom, role, bio, photo}`,
);

const valeurs = [
  {
    title: "Label Bien-être animal",
    text: "Le centre est labellisé Bien-être animal par la FFE, et inscrit ses cavaliers dans cette démarche.",
  },
  {
    title: "Association loi 1901",
    text: "Le centre équestre de Kairon Plage est porté par l'association « Saint Pair Équitation ».",
  },
  {
    title: "Club affilié FFE",
    text: "Poney club et club hippique affiliés à la Fédération Française d'Équitation.",
  },
  {
    title: "Crinières solidaires",
    text: "Un dispositif du Comité départemental d'équitation de la Manche pour les familles à revenus modestes.",
    href: withBase("/tarifs#solidarite"),
    cta: "Aides & solidarité",
  },
];
---

<Layout
  title="Le centre — Kairon Plage"
  description="Pédagogie, équipe, installations, cavalerie et valeurs du centre équestre de Kairon Plage, entre mer et campagne à Saint-Pair-sur-Mer."
>
  <PageHero
    image="hero-vue-aerienne"
    title="Un club qui accompagne chaque cavalier"
    subtitle="Une pédagogie poney depuis plus de 50 ans, entre mer et campagne."
  />

  <section class="section">
    <div class="container">
      <div id="pedagogie" class="split">
        <div>
          <h2 class="title-dots">Notre pédagogie</h2>
          <p class="lede">
            Le centre équestre de Kairon Plage développe depuis plus de 50 ans une pédagogie « poney », dans
            l'esprit du mouvement poney né en France dans les années 1970.
          </p>
          <p class="lede">
            Dès 2 ans, les baby cavaliers se familiarisent avec le poney ; la pédagogie ludique accompagne ensuite
            chaque cavalier vers l'instruction et les passages de galops, jusqu'à la compétition pour qui le
            souhaite : CSO, Equifun, pony games. Les cours « Expert », réservés aux cavaliers d'un minimum Galop 4,
            sont plafonnés à 4 cavaliers.
          </p>
          <a class="btn" href={withBase("/activites")}>Voir toutes les activités</a>
        </div>
        <Photo class="photo split-img" src="manege" alt="Cours à pied avec les poneys dans le manège" sizes="(max-width: 800px) 100vw, 480px" />
      </div>
    </div>
  </section>

  {
    equipe.length > 0 && (
      <section id="equipe" class="band band-mist scallop-top scallop-under">
        <div class="container center">
          <h2 class="title-dots">Notre équipe</h2>
          <ul class="equipe-grid">
            {equipe.map((m: any) => (
              <li class="membre">
                {m.photo ? (
                  <img src={urlFor(m.photo).width(320).height(320).fit("crop").url()} alt={m.photo.alt || m.nom} loading="lazy" />
                ) : (
                  <div class="avatar" aria-hidden="true">
                    <Horse name="peek" />
                  </div>
                )}
                <h3>{m.nom}</h3>
                {m.role && <span class="role">{m.role}</span>}
                {m.bio && <p>{m.bio}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div id="installations" class="split reverse">
        <div>
          <h2 class="title-dots">Nos installations & notre cadre</h2>
          <p class="lede">
            Situé entre mer et campagne à Saint-Pair-sur-Mer, le centre équestre de Kairon Plage bénéficie d'un cadre
            particulièrement adapté à la pratique de l'équitation comme aux promenades et randonnées : carrières,
            sentiers, et un accès direct aux paysages normands de la baie.
          </p>
        </div>
        <Photo class="photo split-img" src="carriere" alt="La carrière de saut d'obstacles du centre" sizes="(max-width: 800px) 100vw, 480px" />
      </div>

      <div id="cavalerie" class="split">
        <div>
          <h2 class="title-dots">Notre cavalerie</h2>
          <p class="lede">
            Le centre accueille des poneys d'expérience, dont certains pratiquent la compétition : Shetland, Welsh et
            poney B notamment. La cavalerie s'enrichit chaque saison, en lien avec l'entreprise familiale de l'un de
            nos enseignants.
          </p>
        </div>
        <Photo class="photo split-img" src="pre-baie" alt="Un cheval au pré, la baie en arrière-plan" sizes="(max-width: 800px) 100vw, 480px" />
      </div>
    </div>
  </section>

  <section id="valeurs" class="section">
    <div class="container">
      <h2 class="title-dots">Nos valeurs, notre association & nos labels</h2>
      <DotList items={valeurs} columns={2} />
      <img
        class="labels"
        src={withBase("/images/labels.png")}
        alt="Labels : Bien-être animal FFE, École Française d'Équitation, Crinières solidaires, Ville de Saint-Pair-sur-Mer"
        loading="lazy"
        width="1452"
        height="296"
      />
    </div>
  </section>
</Layout>

<style>
  .split-img {
    aspect-ratio: 4 / 3;
  }

  .equipe-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 240px));
    justify-content: center;
    gap: var(--space-4);
  }

  .membre img,
  .membre .avatar {
    width: 160px;
    height: 160px;
    margin: 0 auto var(--space-2);
    border-radius: 50%;
    border: 5px solid #fff;
    object-fit: cover;
  }

  .membre .avatar {
    display: grid;
    place-items: end center;
    overflow: hidden;
    background: #fff;
    color: var(--color-meadow);
  }

  .membre .avatar :global(svg) {
    width: 46%;
    margin-bottom: -4px;
    height: auto;
  }

  .membre h3 {
    color: var(--color-pine);
  }

  .membre .role {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0.15rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-teal-strong);
    color: #fff;
    font-size: var(--text-xs);
  }

  .membre p {
    font-size: var(--text-sm);
    margin: 0.7rem 0 0;
  }

  .labels {
    width: min(640px, 100%);
    height: auto;
    margin: var(--space-5) auto 0;
  }
</style>
