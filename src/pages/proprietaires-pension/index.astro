---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Photo from "../../components/Photo.astro";
import DotList from "../../components/DotList.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";

const tarifsPension = await sanityClient.fetch(
  `*[_type == "tarif" && categorie == "pension"] | order(ordre asc){titre, prix, periode, description}`,
);

const euro = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR" });

const services = [
  { title: "Box ou plein-air", text: "Box individuel ou vie au pré, selon les besoins de votre cheval." },
  { title: "Soins quotidiens", text: "Accès aux soins quotidiens et casier personnel pour votre matériel." },
  { title: "Cours & sorties", text: "Heures de cours encadrés et sorties individuelles sur le plat incluses." },
  { title: "Entre mer et campagne", text: "Carrières, sentiers et sorties en extérieur, sous conditions." },
];

const conditions = [
  { title: "Échange préalable", text: "On fait connaissance avec votre cheval et ses habitudes avant son arrivée." },
  { title: "Vaccins à jour", text: "Une condition d'accueil, à préparer avec l'équipe du centre." },
  { title: "Période d'adaptation", text: "Le temps pour votre cheval de prendre ses marques au centre." },
];
---

<Layout
  title="Propriétaires & pension — Kairon Plage"
  description="Pension et demi-pension pour chevaux et poneys au centre équestre de Kairon Plage : box, soins, accès aux installations, tarifs par classe."
>
  <PageHero
    image="pre-baie"
    title="Confier son cheval à Kairon Plage"
    subtitle="Box individuel ou plein-air, soins quotidiens, accès aux carrières et sentiers entre mer et campagne."
  />

  <section id="services" class="section">
    <div class="container split">
      <div>
        <h2 class="title-dots">Nos services</h2>
        <p class="lede">
          Le centre accueille les chevaux et poneys de propriétaires en pension ou demi-pension, sur trois classes
          selon le niveau de pratique du cheval, du loisir jusqu'à la compétition élite ou amateur.
        </p>
        <DotList items={services} />
        <p class="note">Le travail à l'obstacle n'est pas autorisé lors d'un cours encadré.</p>
      </div>
      <Photo class="photo services-img" src="balade-chemin" alt="Balade à cheval sur un chemin de campagne" sizes="(max-width: 800px) 100vw, 480px" />
    </div>
  </section>

  {
    tarifsPension.length > 0 && (
      <section id="tarifs-pension" class="band band-mist scallop-top scallop-under">
        <div class="container-narrow">
          <div class="center">
            <h2 class="title-dots">Tarifs pension</h2>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Formule</th>
                  <th>Tarif</th>
                </tr>
              </thead>
              <tbody>
                {tarifsPension.map((t: any) => (
                  <tr>
                    <td>
                      {t.titre}
                      {t.description && <span class="precision">{t.description}</span>}
                    </td>
                    <td class="price" data-label="Tarif">
                      <span>
                        {euro.format(t.prix)} <span class="periode">/ {t.periode}</span>
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="center">
            <a class="link-arrow" href={withBase("/tarifs#grille")}><span>Voir la grille tarifaire complète</span>&nbsp;→</a>
          </div>
        </div>
      </section>
    )
  }

  <section id="contact-proprietaires" class="section">
    <div class="container admission">
      <div>
        <h2 class="title-dots">Conditions d'admission</h2>
        <p class="lede">L'accueil d'un cheval ou poney en pension se prépare avec l'équipe du centre.</p>
        <DotList items={conditions} numbered />
      </div>

      <div class="panel">
        <h2 class="title-dots">Une place en pension ?</h2>
        <p class="lede">Décrivez-nous votre cheval, on revient vers vous avec les disponibilités et pour organiser une visite.</p>

        <form
          class="form"
          name="demande-pension"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          action={withBase("/merci-pension")}
        >
          <input type="hidden" name="form-name" value="demande-pension" />
          <div class="hidden-field" aria-hidden="true">
            <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </div>

          <p class="form-hint">Les champs marqués <span class="required">*</span> sont obligatoires.</p>

          <div class="field">
            <label for="nom">Nom et prénom <span class="required" aria-hidden="true">*</span></label>
            <input id="nom" name="nom" type="text" autocomplete="name" required />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email <span class="required" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="telephone">Téléphone</label>
              <input id="telephone" name="telephone" type="tel" autocomplete="tel" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="cheval">Nom du cheval / poney</label>
              <input id="cheval" name="cheval" type="text" />
            </div>
            <div class="field">
              <label for="formule">Formule souhaitée</label>
              <select id="formule" name="formule">
                <option value="demi-pension">1/2 pension</option>
                <option value="pension-complete">Pension complète</option>
                <option value="ne-sait-pas">Je ne sais pas encore</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="message">Message (niveau du cheval, disponibilités, questions)</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>

          <button type="submit" class="btn btn-teal">Envoyer ma demande</button>
          <p class="privacy">Vos coordonnées servent uniquement à vous recontacter au sujet de cette demande.</p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services-img {
    aspect-ratio: 4 / 5;
  }

  .precision {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .periode {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .admission {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-5);
    align-items: start;
  }

  @media (max-width: 900px) {
    .admission {
      grid-template-columns: 1fr;
    }
  }
</style>
