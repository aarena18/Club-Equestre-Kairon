---
import Layout from "../../layouts/Layout.astro";
import BentoGrid from "../../components/ui/BentoGrid.astro";
import BentoCard from "../../components/ui/BentoCard.astro";
import PageHero from "../../components/PageHero.astro";
import Horse from "../../components/Horse.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";

const tarifsPension = await sanityClient.fetch(
  `*[_type == "tarif" && categorie == "pension"] | order(ordre asc){titre, prix, periode, description}`,
);

const euro = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR" });

const services = [
  { titre: "Box ou plein-air", texte: "Box individuel ou vie au pré, selon les besoins de votre cheval." },
  { titre: "Soins quotidiens", texte: "Accès aux soins quotidiens et casier personnel pour votre matériel." },
  { titre: "Cours & sorties", texte: "Heures de cours encadrés et sorties individuelles sur le plat incluses." },
  { titre: "Entre mer et campagne", texte: "Carrières, sentiers et sorties en extérieur, sous conditions." },
];
---

<Layout
  title="Propriétaires & pension — Kairon Plage"
  description="Pension et demi-pension pour chevaux et poneys au centre équestre de Kairon Plage : box, soins, accès aux installations, tarifs par classe."
>
  <PageHero
    image="/images/pre-baie.jpg"
    eyebrow="Propriétaires & pension"
    title="Confier son cheval à Kairon Plage"
    subtitle="Box individuel ou plein-air, soins quotidiens, accès aux carrières et sentiers entre mer et campagne."
  />

  <section id="services" class="section">
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Nos services</h2>
        <p class="lede">
          Le centre accueille les chevaux et poneys de propriétaires en pension ou demi-pension, sur trois classes
          selon le niveau de pratique du cheval — du loisir jusqu'à la compétition élite ou amateur.
        </p>
      </div>
      <div class="services">
        <BentoGrid rows={2}>
          <BentoCard
            name="Box ou plein-air"
            description="Box individuel ou vie au pré, selon les besoins de votre cheval."
            icon="home"
            image="/images/pre-baie.jpg"
            area="1 / 1 / 2 / 3"
          />
          <BentoCard
            name="Entre mer et campagne"
            description="Carrières, sentiers et sorties en extérieur, sous conditions."
            icon="leaf"
            image="/images/balade-chemin.jpg"
            area="1 / 3 / 3 / 4"
          />
          <BentoCard
            name="Soins quotidiens"
            description="Accès aux soins quotidiens et casier personnel pour votre matériel."
            icon="sparkles"
            tone="pine"
            area="2 / 1 / 3 / 2"
          />
          <BentoCard
            name="Cours & sorties"
            description="Heures de cours encadrés et sorties individuelles sur le plat incluses."
            icon="calendar"
            image="/images/manege.jpg"
            area="2 / 2 / 3 / 3"
          />
        </BentoGrid>
      </div>
      <p class="note center">Le travail à l'obstacle n'est pas autorisé lors d'un cours encadré.</p>
    </div>
  </section>

  <section id="tarifs-pension" class="band band-mist scallop-top scallop-under">
    <div class="container-narrow">
      <div class="center">
        <h2 class="title-dots">Tarifs pension</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Formule</th>
              <th>Tarif</th>
            </tr>
          </thead>
          <tbody>
            {
              tarifsPension.map((t: any) => (
                <tr>
                  <td>
                    {t.titre}
                    {t.description && <span class="precision">{t.description}</span>}
                  </td>
                  <td>
                    {euro.format(t.prix)} <span class="periode">/ {t.periode}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="center">
        <a class="link-arrow" href={withBase("/tarifs#grille")}>Voir la grille tarifaire complète →</a>
      </div>
    </div>
  </section>

  <section id="admission" class="section">
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Conditions d'admission</h2>
        <p class="lede">L'accueil d'un cheval ou poney en pension se prépare avec l'équipe du centre.</p>
      </div>
      <div class="admission-grid">
        <BentoGrid rows={2}>
          <BentoCard name="Vaccins à jour" description="Une condition d'accueil, à préparer avec l'équipe." icon="shield" tone="mist" area="1 / 1 / 2 / 2" />
          <BentoCard name="Période d'adaptation" description="Le temps de prendre ses marques au centre." icon="clock" tone="teal" area="1 / 2 / 2 / 3" />
          <BentoCard name="Échange préalable" description="Sur les habitudes de votre cheval." icon="heart" tone="meadow" area="1 / 3 / 2 / 4" />
          <BentoCard
            name="Organiser une visite"
            description="Contactez le centre pour convenir ensemble des modalités précises."
            icon="home"
            image="/images/pre-baie.jpg"
            href="#contact-proprietaires"
            cta="Nous écrire"
            area="2 / 1 / 3 / 4"
          />
        </BentoGrid>
      </div>
    </div>
  </section>

  <section id="contact-proprietaires" class="section form-section">
    <Horse name="headRight" class="deco" />
    <div class="container-narrow">
      <div class="form-card">
        <h2 class="title-dots">Une place en pension ?</h2>
        <p class="lede">Décrivez-nous votre cheval, on revient vers vous avec les disponibilités.</p>

        <form
          class="form"
          name="demande-pension"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          action={withBase("/merci-pension")}
        >
          <input type="hidden" name="form-name" value="demande-pension" />
          <p class="hidden-field">
            <label>Ne pas remplir : <input name="bot-field" /></label>
          </p>

          <div class="field">
            <label for="nom">Nom et prénom</label>
            <input id="nom" name="nom" type="text" autocomplete="name" required />
          </div>

          <div class="field-row">
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="telephone">Téléphone</label>
              <input id="telephone" name="telephone" type="tel" autocomplete="tel" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="cheval">Nom du cheval / poney</label>
              <input id="cheval" name="cheval" type="text" />
            </div>
            <div class="field">
              <label for="formule">Formule souhaitée</label>
              <select id="formule" name="formule">
                <option value="demi-pension">1/2 pension</option>
                <option value="pension-complete">Pension complète</option>
                <option value="ne-sait-pas">Je ne sais pas encore</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label for="message">Message (niveau du cheval, disponibilités, questions)</label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>

          <button type="submit" class="btn">Envoyer ma demande</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .services {
    margin: var(--space-4) 0 var(--space-2);
  }

  .precision {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .periode {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .form-section {
    overflow-x: clip;
    padding-top: 0;
  }

  .form-card {
    padding: var(--space-4);
    border-radius: 36px;
    border: 2px solid var(--color-line);
    background: #fff;
    position: relative;
  }

  .deco {
    position: absolute;
    right: 0;
    top: 10%;
    width: clamp(70px, 10vw, 150px);
    height: auto;
    color: var(--color-meadow);
  }

  @media (max-width: 700px) {
    .form-card {
      padding: var(--space-3) var(--space-2);
      border: none;
    }

    .deco {
      display: none;
    }
  }
</style>
