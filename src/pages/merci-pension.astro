---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout title="Merci — Kairon Plage">
  <Header />
  <main>
    <p class="eyebrow">Demande envoyée</p>
    <h1>Merci !</h1>
    <p class="subtitle">
      Votre demande de pension a bien été reçue. Le centre équestre de Kairon Plage vous recontacte avec les
      disponibilités.
    </p>
    <a class="back" href="/">← Retour à l'accueil</a>
  </main>
</Layout>

<style>
  main {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-3);
  }

  .eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: var(--color-sky-deep);
    margin: 0;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-pine);
    margin: var(--space-2) 0;
  }

  .subtitle {
    color: var(--color-ink-soft);
    font-size: 1.05rem;
  }

  .back {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-coral);
    text-decoration: none;
  }
</style>
