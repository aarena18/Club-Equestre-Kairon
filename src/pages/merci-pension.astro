---
import ThankYou from "../components/ThankYou.astro";
import { withBase } from "../lib/url";
---

<ThankYou
  image="pre-baie"
  title="Merci, demande bien reçue"
  subtitle="Le centre équestre de Kairon Plage vous recontacte avec les disponibilités en pension."
  steps={[
    { title: "Le centre vous recontacte", text: "Avec les disponibilités et les formules adaptées à votre cheval." },
    { title: "Visite et échange préalable", text: "Pour faire connaissance avec votre cheval et ses habitudes." },
    {
      title: "Arrivée au centre",
      text: "Vaccins à jour, puis une période d'adaptation pour prendre ses marques.",
      href: withBase("/proprietaires-pension#contact-proprietaires"),
      cta: "Revoir les conditions d'admission",
    },
  ]}
/>
