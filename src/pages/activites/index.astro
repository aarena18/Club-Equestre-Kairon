---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ActivityCard from "../../components/ActivityCard.astro";
import Horse from "../../components/Horse.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";

const activites = await sanityClient.fetch(
  `*[_type == "activite"] | order(ordre asc){titre, "slug": slug.current, categorie, trancheAge, resume, texteBouton, photo}`,
);

// Reprend le découpage validé dans l'arborescence : un hub filtrable
// plutôt qu'un menu à 8 entrées. Le filtre se pré-sélectionne via l'ancre
// (ex. /activites#adultes, utilisé par les cartes "Nos disciplines").
const categories = [
  { value: "tout", label: "Tout" },
  { value: "baby-cavaliers", label: "Baby cavaliers" },
  { value: "enfants-ados", label: "Enfants & ados" },
  { value: "adultes", label: "Adultes" },
  { value: "expert-competition", label: "Expert & compétition" },
  { value: "equitation-adaptee", label: "Équitation adaptée" },
  { value: "balades-randonnees", label: "Balades & randonnées" },
  { value: "stages-vacances", label: "Stages vacances" },
];
---

<Layout
  title="Activités & cours — Kairon Plage"
  description="Baby cavaliers, cours Expert, Equifeel, balades, stages vacances : toutes les activités du centre équestre de Kairon Plage, filtrables par public."
>
  <PageHero
    image="/images/balade-chemin.jpg"
    eyebrow="Activités & cours"
    title="Une activité pour chaque cavalier"
    subtitle="Du baby cavalier au cours Expert, en passant par l'Equifeel et les balades en bord de mer."
  />

  <section class="section hub">
    <Horse name="headLeft" class="deco" />
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Trouvez la vôtre</h2>
      </div>
      <div class="filters" role="group" aria-label="Filtrer les activités par catégorie">
        {
          categories.map((c) => (
            <button type="button" class="filter-btn" data-filter={c.value} aria-pressed={c.value === "tout" ? "true" : "false"}>
              {c.label}
            </button>
          ))
        }
      </div>

      <div class="grid activites-grid">
        {
          activites.map((a: any) => (
            <ActivityCard
              titre={a.titre}
              trancheAge={a.trancheAge}
              resume={a.resume}
              categorie={a.categorie}
              texteBouton={a.texteBouton}
              photo={a.photo}
              href={a.slug ? withBase(`/activites/${a.slug}`) : undefined}
            />
          ))
        }
      </div>
      <p class="empty note" hidden>Pas encore d'activité dans cette catégorie — contactez le centre pour en savoir plus.</p>
    </div>
  </section>

  <section class="band scallop-top scallop-under">
    <div class="container-narrow center">
      <h2 class="title-dots on-color">Pas sûr de votre choix ?</h2>
      <p>Un cours d'essai permet de faire connaissance avec les poneys, l'équipe et le cadre. On vous oriente ensuite.</p>
      <a class="btn" href={withBase("/infos-pratiques#essai")}>Réserver un cours d'essai</a>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".activity-card");
  const empty = document.querySelector<HTMLElement>(".empty")!;

  function apply(filter: string) {
    let visible = 0;
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === filter)));
    cards.forEach((card) => {
      const match = filter === "tout" || card.dataset.categorie === filter;
      card.hidden = !match;
      if (match) visible++;
    });
    empty.hidden = visible > 0;
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter!;
      apply(filter);
      history.replaceState(null, "", filter === "tout" ? location.pathname : `#${filter}`);
    });
  });

  const fromHash = location.hash.slice(1);
  if (fromHash && [...buttons].some((b) => b.dataset.filter === fromHash)) apply(fromHash);
</script>

<style>
  .hub {
    overflow-x: clip;
  }

  .deco {
    position: absolute;
    left: 0;
    top: 60px;
    width: clamp(60px, 9vw, 130px);
    height: auto;
    color: var(--color-teal);
  }

  .filters {
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .activites-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
  }

  .activites-grid :global([hidden]) {
    display: none;
  }

  .empty {
    text-align: center;
  }

  .band .btn {
    margin-top: var(--space-2);
  }

  .band p {
    font-size: 1.08rem;
  }
</style>
