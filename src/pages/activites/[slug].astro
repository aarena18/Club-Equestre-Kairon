---
import { toHTML } from "@portabletext/to-html";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { sanityClient, urlFor } from "../../lib/sanity";
import { withBase } from "../../lib/url";
import { photoParCategorie } from "../../data/site";

export async function getStaticPaths() {
  const activites = await sanityClient.fetch(
    `*[_type == "activite" && defined(slug.current)]{"slug": slug.current}`,
  );

  return activites.map((a: { slug: string }) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;

const activite = await sanityClient.fetch(
  `*[_type == "activite" && slug.current == $slug][0]{titre, categorie, trancheAge, resume, description, photo}`,
  { slug },
);

const descriptionHtml = activite?.description ? toHTML(activite.description) : "";
const heroExternal = Boolean(activite.photo);
const heroImage = activite.photo
  ? urlFor(activite.photo).width(1800).height(900).fit("crop").url()
  : photoParCategorie[activite.categorie] ?? "/images/manege.jpg";
---

<Layout title={`${activite.titre} — Kairon Plage`} description={activite.resume ?? undefined}>
  <PageHero
    image={heroImage}
    external={heroExternal}
    eyebrow={activite.trancheAge ?? "Activités & cours"}
    title={activite.titre}
    subtitle={activite.resume ?? undefined}
  />

  <section class="section">
    <div class="container-narrow">
      <a class="back" href={withBase("/activites")}>← Toutes les activités</a>
      {descriptionHtml ? <div class="prose" set:html={descriptionHtml} /> : <p class="note">Description détaillée à venir.</p>}

      <div class="cta-card">
        <div>
          <h2>Envie d'essayer ?</h2>
          <p>Un premier cours pour découvrir le club, sans engagement.</p>
        </div>
        <a class="btn" href={withBase("/infos-pratiques#essai")}>Réserver un cours d'essai</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-weight: 500;
    color: var(--color-meadow-deep);
    text-decoration: none;
  }

  .cta-card {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-teal-mist);
  }

  .cta-card h2 {
    font-size: 1.2rem;
    color: var(--color-pine);
  }

  .cta-card p {
    margin: 0.3rem 0 0;
    color: var(--color-ink-soft);
  }
</style>
