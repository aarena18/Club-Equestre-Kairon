---
import { toHTML } from "@portabletext/to-html";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { sanityClient, urlFor } from "../../lib/sanity";
import { withBase } from "../../lib/url";
import { bandeauParCategorie, ctaInscription } from "../../data/site";

export async function getStaticPaths() {
  const activites = await sanityClient.fetch(
    `*[_type == "activite" && defined(slug.current)]{"slug": slug.current}`,
  );

  return activites.map((a: { slug: string }) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;

const activite = await sanityClient.fetch(
  `*[_type == "activite" && slug.current == $slug][0]{titre, categorie, trancheAge, resume, description, photo}`,
  { slug },
);

const descriptionHtml = activite?.description ? toHTML(activite.description) : "";
const heroImage = activite.photo
  ? urlFor(activite.photo).width(1800).height(900).fit("crop").url()
  : (bandeauParCategorie[activite.categorie] ?? "manege");
---

<Layout title={`${activite.titre} — Kairon Plage`} description={activite.resume ?? undefined}>
  <PageHero image={heroImage} title={activite.titre} subtitle={activite.resume ?? undefined} />

  <section class="section">
    <div class="container-narrow">
      <a class="link-arrow back" href={withBase("/activites")}>← <span>Toutes les activités</span></a>
      {activite.trancheAge && <p class="tag">{activite.trancheAge}</p>}
      {descriptionHtml && <div class="prose" set:html={descriptionHtml} />}

      <div class="panel panel-mist cta-panel">
        <div>
          <h2>Envie d'essayer ?</h2>
          <p>L'inscription commence par un cours d'essai, sans engagement.</p>
        </div>
        <a class="btn btn-teal" href={withBase(ctaInscription.href)}>{ctaInscription.label}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .back {
    margin-bottom: var(--space-2);
  }

  .tag {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: 0.2rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-teal-mist);
    color: var(--color-teal-deep);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cta-panel {
    margin-top: var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta-panel h2 {
    font-size: var(--text-h3);
    color: var(--color-pine);
  }

  .cta-panel p {
    margin: 0.3rem 0 0;
    color: var(--color-ink-soft);
  }
</style>
