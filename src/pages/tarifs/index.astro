---
import Layout from "../../layouts/Layout.astro";
import BentoGrid from "../../components/ui/BentoGrid.astro";
import BentoCard from "../../components/ui/BentoCard.astro";
import PageHero from "../../components/PageHero.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";

const tarifs = await sanityClient.fetch(
  `*[_type == "tarif"] | order(ordre asc){titre, categorie, publicConcerne, prix, prixPromo, periode, description, eligibleSolidarite}`,
);

const groupes = [
  { value: "licence-cotisation", label: "Licence & cotisation", note: "Exigibles à compter du 01/09." },
  { value: "forfait-eco-annuel", label: "Forfaits éco — à l'année", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "forfait-eco-trimestriel", label: "Forfaits éco — au trimestre", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "forfait-famille", label: "Forfait famille", note: "Réservé aux jours et horaires accessibles aux forfaits famille." },
  { value: "forfait-performance", label: "Forfait Expert (performance)", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "pension", label: "Pension & demi-pension", note: "Par mois, de septembre à juin." },
];

const parGroupe = groupes.map((g) => ({
  ...g,
  lignes: tarifs.filter((t: any) => t.categorie === g.value),
}));

const euro = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR" });
---

<Layout
  title="Tarifs & inscription — Kairon Plage"
  description="Grille tarifaire complète du centre équestre de Kairon Plage : licence, cotisation, forfaits, pension. Comment s'inscrire et les aides disponibles."
>
  <PageHero
    image="/images/manege.jpg"
    eyebrow="Tarifs & inscription"
    title="Une grille claire, pas un PDF à télécharger"
    subtitle="Tous les tarifs 2026/2027 du centre, à jour. Le contrat d'inscription reste disponible plus bas."
  />

  <section id="grille" class="section">
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Grille tarifaire</h2>
      </div>
      <nav class="filters jump" aria-label="Aller à une catégorie de tarifs">
        {parGroupe.filter((g) => g.lignes.length > 0).map((g) => <a class="filter-btn" href={`#${g.value}`}>{g.label}</a>)}
      </nav>
      {
        parGroupe.map(
          (groupe) =>
            groupe.lignes.length > 0 && (
              <div class="groupe" id={groupe.value}>
                <div class="groupe-head">
                  <h3>{groupe.label}</h3>
                  <p>{groupe.note}</p>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Forfait</th>
                        {groupe.lignes.some((l: any) => l.publicConcerne) && <th>Public</th>}
                        {groupe.lignes.some((l: any) => l.prixPromo) && <th>Tarif promo</th>}
                        <th>{groupe.lignes.some((l: any) => l.prixPromo) ? "Tarif rentrée" : "Tarif"}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {groupe.lignes.map((ligne: any) => (
                        <tr>
                          <td>
                            {ligne.titre}
                            {ligne.eligibleSolidarite && <span class="badge">Crinières solidaires</span>}
                            {ligne.description && <span class="precision">{ligne.description}</span>}
                          </td>
                          {groupe.lignes.some((l: any) => l.publicConcerne) && <td>{ligne.publicConcerne ?? "—"}</td>}
                          {groupe.lignes.some((l: any) => l.prixPromo) && (
                            <td class="promo">{ligne.prixPromo ? euro.format(ligne.prixPromo) : "—"}</td>
                          )}
                          <td>
                            {euro.format(ligne.prix)} <span class="periode">/ {ligne.periode}</span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ),
        )
      }
    </div>
  </section>

  <section id="inscription" class="band band-mist scallop-top scallop-under">
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Comment s'inscrire</h2>
      </div>
      <BentoGrid rows={2}>
        <BentoCard
          name="1 · Réservez un cours d'essai"
          description="Sans engagement, via le formulaire de contact."
          icon="calendar"
          image="/images/enfants.jpg"
          href="/infos-pratiques#essai"
          cta="Réserver un cours d'essai"
          area="1 / 1 / 3 / 2"
        />
        <BentoCard
          name="2 · Remplissez le contrat"
          description="Contrat d'inscription (mineur ou majeur), souscrit chaque année entre le centre et le cavalier."
          icon="file"
          image="/images/plage-groupe.jpg"
          area="1 / 2 / 2 / 4"
        />
        <BentoCard
          name="3 · Choisissez votre forfait"
          description="Dans la grille ci-dessus. Un règlement échelonné jusqu'à 5 échéances peut être proposé."
          icon="euro"
          image="/images/pre-baie.jpg"
          area="2 / 2 / 3 / 4"
        />
      </BentoGrid>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <BentoGrid rows={1}>
        <BentoCard
          id="solidarite"
          name="Aides & solidarité"
          description="Le dispositif « Crinières solidaires », porté par le Comité départemental d'équitation de la Manche, aide les familles à revenus modestes à accéder aux forfaits marqués « Crinières solidaires ». Contactez le centre pour connaître votre éligibilité."
          icon="users"
          image="/images/vacances.jpg"
          href="/infos-pratiques#essai"
          cta="Contacter le centre"
          area="1 / 1 / 2 / 3"
        />
        <BentoCard
          id="documents"
          name="Documents & règlement"
          description="À télécharger ici dès que le club nous aura transmis les fichiers à jour."
          icon="file"
          tone="mist"
          area="1 / 3 / 2 / 4"
        >
          <ul>
            <li>Contrat d'inscription — mineur</li>
            <li>Contrat d'inscription — majeur</li>
            <li>Règlement intérieur</li>
            <li>Conditions générales de vente</li>
          </ul>
        </BentoCard>
      </BentoGrid>
    </div>
  </section>
</Layout>

<style>
  .jump {
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .jump a {
    text-decoration: none;
  }

  .groupe {
    scroll-margin-top: 110px;
  }

  .groupe + .groupe {
    margin-top: var(--space-5);
  }

  .groupe-head h3 {
    font-size: 1.1rem;
    color: var(--color-pine);
  }

  .groupe-head p {
    font-size: 0.88rem;
    color: var(--color-ink-faint);
    margin: 0.3rem 0 0.9rem;
  }

  .promo {
    color: var(--color-meadow-deep) !important;
    font-weight: 600;
  }

  .periode {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .badge {
    display: inline-block;
    margin: 0.35rem 0 0 0.5rem;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-sun);
    color: var(--color-ink);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    vertical-align: middle;
  }

  .precision {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }
</style>
