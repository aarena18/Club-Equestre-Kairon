---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";

const tarifs = await sanityClient.fetch(
  `*[_type == "tarif"] | order(ordre asc){titre, categorie, publicConcerne, prix, prixPromo, periode, description, eligibleSolidarite}`,
);

const groupes = [
  { value: "licence-cotisation", label: "Licence & cotisation", note: "Exigibles à compter du 01/09." },
  { value: "forfait-eco-annuel", label: "Forfaits éco — à l'année", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "forfait-eco-trimestriel", label: "Forfaits éco — au trimestre", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "forfait-famille", label: "Forfait famille", note: "Réservé aux jours et horaires accessibles aux forfaits famille." },
  { value: "forfait-performance", label: "Forfait Expert (performance)", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "pension", label: "Pension & demi-pension", note: "Par mois, de septembre à juin." },
];

const parGroupe = groupes.map((g) => ({
  ...g,
  lignes: tarifs.filter((t: any) => t.categorie === g.value),
}));

const euro = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR" });
---

<Layout
  title="Tarifs & inscription — Kairon Plage"
  description="Grille tarifaire complète du centre équestre de Kairon Plage : licence, cotisation, forfaits, pension. Comment s'inscrire et les aides disponibles."
>
  <PageHero
    image="/images/manege.jpg"
    eyebrow="Tarifs & inscription"
    title="Une grille claire, pas un PDF à télécharger"
    subtitle="Tous les tarifs 2026/2027 du centre, à jour. Le contrat d'inscription reste disponible plus bas."
  />

  <section id="grille" class="section">
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Grille tarifaire</h2>
      </div>
      <nav class="filters jump" aria-label="Aller à une catégorie de tarifs">
        {parGroupe.filter((g) => g.lignes.length > 0).map((g) => <a class="filter-btn" href={`#${g.value}`}>{g.label}</a>)}
      </nav>
      {
        parGroupe.map(
          (groupe) =>
            groupe.lignes.length > 0 && (
              <div class="groupe" id={groupe.value}>
                <div class="groupe-head">
                  <h3>{groupe.label}</h3>
                  <p>{groupe.note}</p>
                </div>
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>Forfait</th>
                        {groupe.lignes.some((l: any) => l.publicConcerne) && <th>Public</th>}
                        {groupe.lignes.some((l: any) => l.prixPromo) && <th>Tarif promo</th>}
                        <th>{groupe.lignes.some((l: any) => l.prixPromo) ? "Tarif rentrée" : "Tarif"}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {groupe.lignes.map((ligne: any) => (
                        <tr>
                          <td>
                            {ligne.titre}
                            {ligne.eligibleSolidarite && <span class="badge">Crinières solidaires</span>}
                            {ligne.description && <span class="precision">{ligne.description}</span>}
                          </td>
                          {groupe.lignes.some((l: any) => l.publicConcerne) && <td>{ligne.publicConcerne ?? "—"}</td>}
                          {groupe.lignes.some((l: any) => l.prixPromo) && (
                            <td class="promo">{ligne.prixPromo ? euro.format(ligne.prixPromo) : "—"}</td>
                          )}
                          <td>
                            {euro.format(ligne.prix)} <span class="periode">/ {ligne.periode}</span>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ),
        )
      }
    </div>
  </section>

  <section id="inscription" class="band band-mist scallop-top scallop-under">
    <div class="container">
      <div class="center">
        <h2 class="title-dots">Comment s'inscrire</h2>
      </div>
      <ol class="steps">
        <li>
          <span class="num">1</span>
          <h3>Réservez un cours d'essai</h3>
          <p>Sans engagement, via le <a href={withBase("/infos-pratiques#essai")}>formulaire de contact</a>.</p>
        </li>
        <li>
          <span class="num">2</span>
          <h3>Remplissez le contrat</h3>
          <p>Contrat d'inscription (mineur ou majeur), souscrit chaque année entre le centre et le cavalier.</p>
        </li>
        <li>
          <span class="num">3</span>
          <h3>Choisissez votre forfait</h3>
          <p>Dans la grille ci-dessus. Un règlement échelonné jusqu'à 5 échéances peut être proposé.</p>
        </li>
      </ol>
    </div>
  </section>

  <section id="solidarite" class="section">
    <div class="container-narrow">
      <div class="solidarite">
        <h2 class="title-dots">Aides & solidarité</h2>
        <p>
          Le dispositif <strong>« Crinières solidaires »</strong>, porté par le Comité départemental d'équitation de
          la Manche, aide les familles à revenus modestes à accéder aux forfaits marqués « Crinières solidaires »
          ci-dessus. Contactez le centre pour connaître votre éligibilité.
        </p>
      </div>
    </div>
  </section>

  <section id="documents" class="section documents">
    <div class="container-narrow">
      <h2 class="title-dots">Documents & règlement</h2>
      <p class="note">
        Les documents du club (contrat d'inscription, règlement intérieur, conditions générales de vente,
        attestation d'assurance) seront mis en téléchargement ici dès que le club nous aura transmis les fichiers à
        jour.
      </p>
      <ul class="docs">
        <li>Contrat d'inscription — cavalier mineur</li>
        <li>Contrat d'inscription — cavalier majeur</li>
        <li>Règlement intérieur du centre équestre</li>
        <li>Conditions générales de vente</li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .jump {
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .jump a {
    text-decoration: none;
  }

  .groupe {
    scroll-margin-top: 110px;
  }

  .groupe + .groupe {
    margin-top: var(--space-5);
  }

  .groupe-head h3 {
    font-size: 1.1rem;
    color: var(--color-pine);
  }

  .groupe-head p {
    font-size: 0.88rem;
    color: var(--color-ink-faint);
    margin: 0.3rem 0 0.9rem;
  }

  .promo {
    color: var(--color-meadow-deep) !important;
    font-weight: 600;
  }

  .periode {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .badge {
    display: inline-block;
    margin: 0.35rem 0 0 0.5rem;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-sun);
    color: var(--color-ink);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    vertical-align: middle;
  }

  .precision {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  /* étapes */
  .steps {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-3);
  }

  .steps li {
    background: #fff;
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-3) var(--space-3);
    position: relative;
    text-align: center;
  }

  .num {
    position: absolute;
    top: -22px;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-meadow-deep);
    color: #fff;
    font-weight: 700;
    font-size: 1.2rem;
  }

  .steps h3 {
    font-size: 1rem;
    color: var(--color-pine);
  }

  .steps p {
    margin: 0.6rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }

  .solidarite {
    padding: var(--space-4);
    border-radius: 36px;
    background: var(--color-sun);
  }

  .solidarite h2 {
    --dots: var(--color-ink);
  }

  .solidarite p {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.05rem;
  }

  .documents {
    padding-top: 0;
  }

  .docs {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .docs li {
    padding: 0.9rem 1.2rem;
    border: 2px dashed var(--color-line);
    border-radius: 18px;
    color: var(--color-ink-faint);
  }
</style>
