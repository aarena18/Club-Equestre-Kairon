---
import Layout from "../../layouts/Layout.astro";
import DotList from "../../components/DotList.astro";
import PageHero from "../../components/PageHero.astro";
import { sanityClient } from "../../lib/sanity";
import { withBase } from "../../lib/url";
import { ctaInscription } from "../../data/site";

const tarifs = await sanityClient.fetch(
  `*[_type == "tarif"] | order(ordre asc){titre, categorie, publicConcerne, prix, prixPromo, periode, description, eligibleSolidarite}`,
);

const groupes = [
  { value: "licence-cotisation", label: "Licence & cotisation", note: "Exigibles à compter du 01/09." },
  { value: "forfait-eco-annuel", label: "Forfaits éco à l'année", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "forfait-eco-trimestriel", label: "Forfaits éco au trimestre", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "forfait-famille", label: "Forfait famille", note: "Réservé aux jours et horaires accessibles aux forfaits famille." },
  { value: "forfait-performance", label: "Forfait Expert (performance)", note: "Tarif promo si souscription avant le 28/08/2026." },
  { value: "pension", label: "Pension & demi-pension", note: "Par mois, de septembre à juin." },
];

const parGroupe = groupes.map((g) => ({
  ...g,
  lignes: tarifs.filter((t: any) => t.categorie === g.value),
}));

const euro = new Intl.NumberFormat("fr-FR", { style: "currency", currency: "EUR" });

const etapes = [
  {
    title: "Réservez un cours d'essai",
    text: "Sans engagement : dites-nous l'âge et le niveau du cavalier, le centre vous recontacte.",
    href: withBase(ctaInscription.href),
    cta: "Demander un cours d'essai",
  },
  {
    title: "Remplissez le contrat",
    text: "Contrat d'inscription (mineur ou majeur), souscrit chaque année entre le centre et le cavalier.",
  },
  {
    title: "Choisissez votre forfait",
    text: "Dans la grille ci-dessus. Un règlement échelonné jusqu'à 5 échéances peut être proposé.",
  },
];
---

<Layout
  title="Tarifs & inscription — Kairon Plage"
  description="Grille tarifaire complète du centre équestre de Kairon Plage : licence, cotisation, forfaits, pension. Comment s'inscrire et les aides disponibles."
>
  <PageHero
    image="manege"
    title="Tarifs & inscription 2026/2027"
    subtitle="Licence, forfaits et pension : tous les tarifs de la saison, puis les trois étapes pour s'inscrire."
  />

  <section id="grille" class="section">
    <div class="container">
      <h2 class="title-dots">Grille tarifaire</h2>
      <nav class="filters scroll-row jump" aria-label="Aller à une catégorie de tarifs">
        {parGroupe.filter((g) => g.lignes.length > 0).map((g) => <a class="filter-btn" href={`#${g.value}`}>{g.label}</a>)}
      </nav>
      {
        parGroupe.map((groupe) => {
          if (groupe.lignes.length === 0) return null;
          const avecPublic = groupe.lignes.some((l: any) => l.publicConcerne);
          const avecPromo = groupe.lignes.some((l: any) => l.prixPromo);
          return (
            <div class="groupe" id={groupe.value}>
              <div class="groupe-head">
                <h3>{groupe.label}</h3>
                <p>{groupe.note}</p>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Forfait</th>
                      {avecPublic && <th>Public</th>}
                      {avecPromo && <th>Tarif promo</th>}
                      <th>{avecPromo ? "Tarif rentrée" : "Tarif"}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {groupe.lignes.map((ligne: any) => (
                      <tr>
                        <td>
                          {ligne.titre}
                          {ligne.eligibleSolidarite && <span class="badge">Crinières solidaires</span>}
                          {ligne.description && <span class="precision">{ligne.description}</span>}
                        </td>
                        {avecPublic && <td data-label="Public">{ligne.publicConcerne ?? "Tous"}</td>}
                        {avecPromo && (
                          <td class="price-promo" data-label="Tarif promo">
                            {ligne.prixPromo ? euro.format(ligne.prixPromo) : "Sans promo"}
                          </td>
                        )}
                        <td class="price" data-label={avecPromo ? "Tarif rentrée" : "Tarif"}>
                          <span>
                            {euro.format(ligne.prix)} <span class="periode">/ {ligne.periode}</span>
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <section id="inscription" class="band band-mist scallop-top scallop-under">
    <div class="container-narrow">
      <h2 class="title-dots">Comment s'inscrire</h2>
      <DotList items={etapes} numbered />
    </div>
  </section>

  <section class="section">
    <div class="container-narrow">
      <div id="solidarite" class="panel panel-sun">
        <h2 class="title-dots">Aides & solidarité</h2>
        <p>
          Le dispositif <strong>« Crinières solidaires »</strong>, porté par le Comité départemental d'équitation de la
          Manche, aide les familles à revenus modestes à accéder aux forfaits marqués « Crinières solidaires » dans la
          grille. Contactez le centre pour connaître votre éligibilité.
        </p>
        <a class="btn" href={withBase("/infos-pratiques#coordonnees")}>Contacter le centre</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .jump {
    margin-bottom: var(--space-4);
  }

  .groupe {
    scroll-margin-top: var(--header-offset);
  }

  .groupe + .groupe {
    margin-top: var(--space-5);
  }

  .groupe-head h3 {
    color: var(--color-pine);
  }

  .groupe-head p {
    font-size: var(--text-sm);
    color: var(--color-ink-faint);
    margin: 0.3rem 0 0.9rem;
  }

  .periode {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .badge {
    display: inline-block;
    margin: 0.35rem 0 0 0.5rem;
    padding: 0.1rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-sun);
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 600;
    vertical-align: middle;
  }

  .precision {
    display: block;
    margin-top: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-ink-faint);
  }

  .panel-sun p {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }

  @media (max-width: 640px) {
    .badge {
      display: table;
      margin: 0.35rem 0 0;
    }
  }
</style>
