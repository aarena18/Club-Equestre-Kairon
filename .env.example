# Copiez ce fichier en .env et remplissez avec les valeurs de votre
# projet Sanity (créé via `npx sanity login` puis `npx sanity init`
# depuis la racine du projet — voir le README, section CMS).
#
# Ces deux valeurs ne sont pas secrètes : elles sont visibles côté
# navigateur, c'est normal pour un projectId/dataset Sanity.

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
